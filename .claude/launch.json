{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "laravel-api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "laravel-api/run_api.ps1"],
      "port": 8000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "Rhayzkicks Mobile/run_web.ps1"],
      "port": 8090
    },
    {
      "name": "web-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "exec", "--", "vite", "preview", "web", "--host", "0.0.0.0", "--port", "4173", "--strictPort"],
      "port": 4173,
      "autoPort": false
    }
  ]
}
